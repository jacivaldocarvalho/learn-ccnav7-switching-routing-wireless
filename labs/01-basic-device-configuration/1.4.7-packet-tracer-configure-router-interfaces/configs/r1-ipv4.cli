! Lab-only commands. Serial0/0/0 was preconfigured; leave unchanged.
configure terminal
interface GigabitEthernet0/0
 description LAN_PC1_SW1
 ip address 172.16.20.1 255.255.255.128
 no shutdown
exit
interface GigabitEthernet0/1
 description LAN_PC2_SW2
 ip address 172.16.20.129 255.255.255.128
 no shutdown
end
! Optional after successful validation: copy running-config startup-config
