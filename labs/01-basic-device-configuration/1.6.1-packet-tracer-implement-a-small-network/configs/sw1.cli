configure terminal
hostname SW1
service password-encryption
enable secret Ciscoenpa55
interface Vlan1
 ip address 10.10.10.2 255.255.255.0
 no shutdown
exit
ip default-gateway 10.10.10.1
line console 0
 password Ciscolinepa55
 login
exit
line vty 0 15
 transport input all
 password Ciscolinepa55
 login
exit
end
copy running-config startup-config
